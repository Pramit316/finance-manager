# ────────────────────────────────────────────────────────────────────
# Frontend Environment Variables (.env or .env.local)
# ────────────────────────────────────────────────────────────────────
# VITE_ prefix is REQUIRED — Vite only exposes prefixed variables to
# browser-side code. These are safe to expose publicly.

# === Backend API URL ===
# Local development:
VITE_API_URL=http://localhost:8000
# Production (set in Cloudflare Pages dashboard):
# VITE_API_URL=https://fintrack-api.onrender.com

# === Supabase (public/anon key ONLY — safe for frontend) ===
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# ────────────────────────────────────────────────────────────────────
# NEVER put the following in frontend code:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - DATABASE_URL
#   - Any server-side secrets
# ────────────────────────────────────────────────────────────────────
