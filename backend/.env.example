# ────────────────────────────────────────────────────────────────────
# Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ────────────────────────────────────────────────────────────────────

# ═══ LOCAL DEVELOPMENT ═══════════════════════════════════════════════
# Use local PostgreSQL for development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_tracker

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment (development | production)
ENVIRONMENT=development

# ═══ SUPABASE AUTH ═══════════════════════════════════════════════════
# Found in: Supabase Dashboard → Settings → API → JWT Secret
# Leave EMPTY to disable auth in local development.
SUPABASE_JWT_SECRET=

# ═══ PRODUCTION (Render environment variables) ═══════════════════════
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# CORS_ORIGINS=https://fintrack.pramitbhattarai.com.np
# ENVIRONMENT=production
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ────────────────────────────────────────────────────────────────────
# SECURITY NOTES:
# - DATABASE_URL contains your database password — NEVER expose it
# - SUPABASE_JWT_SECRET is a server-side secret — NEVER send to frontend
# - The Supabase anon/public key is safe for frontend use
# - The Supabase service_role key must NEVER be in frontend code
# ────────────────────────────────────────────────────────────────────
