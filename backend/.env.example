# ────────────────────────────────────────────────────────────────────
# Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ────────────────────────────────────────────────────────────────────

# ═══ LOCAL DEVELOPMENT ═══════════════════════════════════════════════
# Use local PostgreSQL for development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finance_tracker

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment (development | production)
ENVIRONMENT=development

# ═══ SUPABASE AUTH ═══════════════════════════════════════════════════
# Recommended: Provide SUPABASE_URL to verify asymmetric JWTs via JWKS endpoint
# e.g. https://irvnzqygeoyjgwzdlxxd.supabase.co
SUPABASE_URL=
# Or explicit JWKS endpoint:
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Legacy symmetric secret (only needed if your project uses HS256)
# SUPABASE_JWT_SECRET=

# Leave both EMPTY to disable auth in local development.

# ═══ PRODUCTION (Render environment variables) ═══════════════════════
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# CORS_ORIGINS=https://fintrack.pramitbhattarai.com.np
# ENVIRONMENT=production
# SUPABASE_URL=https://irvnzqygeoyjgwzdlxxd.supabase.co
# Note: SUPABASE_JWT_SECRET is NOT required on Render when SUPABASE_URL is provided,
# because public verification keys are fetched dynamically from the JWKS endpoint.

# ═══ GMAIL OAUTH (server-side only) ══════════════════════════════════
# Google Cloud OAuth 2.0 Web Application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development callback. Add this URI as an additional Google Cloud
# authorized redirect URI; keep the production URI configured in Render.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
# Production Render callback (set this in the Render environment only):
# https://finance-manager-kk0p.onrender.com/api/gmail/oauth/callback
FRONTEND_OAUTH_SUCCESS_URI=http://localhost:5173/imports
# Production keeps the existing popup callback response; do not set this on Render.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=
# Keep this restricted to the configured Nabil alert sender.
GMAIL_ALLOWED_SENDER=txn-alert@nabilbank.com
GMAIL_SYNC_BATCH_SIZE=50

# ────────────────────────────────────────────────────────────────────
# SECURITY NOTES:
# - DATABASE_URL contains your database password — NEVER expose it
# - SUPABASE_JWT_SECRET is a server-side secret — NEVER send to frontend
# - The Supabase anon/public key is safe for frontend use
# - The Supabase service_role key must NEVER be in frontend code
# ────────────────────────────────────────────────────────────────────
